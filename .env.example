# Optional: SerpAPI key for live Google Flights quotes at build / CI time.
# Without it, public/data/flight-quote.json is used as the reference snapshot.
SERPAPI_KEY=

# Optional: CARTO basemaps API key (free at https://carto.com/basemaps/apikey/).
# Without it, the map uses OpenStreetMap tiles (no watermark / no "API key required").
VITE_CARTO_BASEMAPS_API_KEY=
